# ─────────────────────────────────────────────────────
# OLIMPO API — Variables de entorno
# Copia este archivo como .env y completa los valores
# NUNCA subas el .env real a git
# ─────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# ─── Supabase / PostgreSQL ────────────────────────────
# Obtén estas URLs en: Supabase Dashboard → Connect → ORMs → Prisma
#
# Tu PROJECT_REF es: dvqqzwupbeqfixmmpczs
# Reemplaza [TU-PASSWORD] con la contraseña que configuraste en Supabase
#
DATABASE_URL="postgresql://postgres.dvqqzwupbeqfixmmpczs:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.dvqqzwupbeqfixmmpczs:[TU-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Autenticación JWT ────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_STRING_ALEATORIO_LARGO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Twilio (WhatsApp) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Logging ──────────────────────────────────────────
LOG_LEVEL=debug

# ─── Setup inicial ────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
SETUP_TOKEN=GENERA_UN_TOKEN_SECRETO_AQUI
