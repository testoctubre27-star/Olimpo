// ─────────────────────────────────────────────
// OLIMPO — Prisma Schema
// Database: PostgreSQL on Supabase
// ORM: Prisma v5
// ─────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum StudentStatus {
  PENDING_PAYMENT   // Onboarding, esperando primer pago
  ACTIVE            // Al corriente
  DELINQUENT        // Moroso, dentro de periodo de gracia
  SUSPENDED         // Lugar liberado por falta de pago
  INACTIVE          // Baja voluntaria
}

enum Modality {
  PERSONAL_CHILD // Legado — reemplazado por fases de bebes
  BABY_PHASE1    // Natacion bebes fase 1: 4-12 meses, maestra dedicada
  BABY_PHASE2    // Natacion bebes fase 2: 1-3 anios, maestra dedicada
  BABY_PHASE3    // Natacion bebes fase 3: 3-5 anios, maestra dedicada
  GROUP_CHILD    // Natacion grupal infantil (max 8 por maestro)
  GROUP_ADULT    // Natacion adultos grupal
  FREE_ACCESS    // Acceso libre lunes a viernes
  AQUA_THERAPY   // Terapia acuatica - rehab y movilidad
}

enum PaymentType {
  ENROLLMENT        // Inscripción anual
  MONTHLY           // Mensualidad
  PROPORTIONAL      // Mensualidad proporcional (ingreso a mes en curso)
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum ConversationState {
  NEW_CONTACT
  AWAITING_NAME
  AWAITING_MODALITY
  AWAITING_SCHEDULE
  AWAITING_REGULATION_ACCEPT
  PENDING_PAYMENT_CONFIRMATION
  ACTIVE
  DELINQUENT
  SUSPENDED
}

enum AutomationLogStatus {
  SUCCESS
  FAILED
  SKIPPED
}

// ─── Users (admin / teacher login) ────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher    Teacher?
  auditLogs  AuditLog[]
  sessions   UserSession[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// ─── Teachers ─────────────────────────────────

model Teacher {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  phone       String
  commissionPct Decimal @default(0) @db.Decimal(5, 2) // % del pago que le corresponde
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User                  @relation(fields: [userId], references: [id])
  scheduleSlots ScheduleSlot[]
  schedules     Schedule[]
  students      Student[]
  summerCourses SummerCourseTeacher[]

  @@map("teachers")
}

// ─── Modalities & Schedule Templates ──────────

model ModalityConfig {
  id          String   @id @default(cuid())
  modality    Modality @unique
  name        String
  description String?
  maxCapacity Int
  monthlyFee  Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  schedules Schedule[]
  scheduleModalities ScheduleModality[]

  @@map("modality_configs")
}

// Free-form services not tied to the Modality enum
model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  monthlyFee  Decimal  @db.Decimal(10, 2)
  maxCapacity Int
  isActive    Boolean  @default(true)
  icon        String?  // emoji or icon identifier
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

// A recurring time slot on a given weekday
model Schedule {
  id           String   @id @default(cuid())
  modalityId   String
  teacherId    String?
  dayOfWeek    Int
  startTime    String
  endTime      String
  capacity     Int      @default(8)
  isActive     Boolean  @default(true)
  pairedWithId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  modality    ModalityConfig @relation(fields: [modalityId], references: [id])
  teacher     Teacher?       @relation(fields: [teacherId], references: [id])
  slots       ScheduleSlot[]
  waitingList WaitingList[]
  pairedWith  Schedule?      @relation("SchedulePair", fields: [pairedWithId], references: [id])
  pairedBy    Schedule[]     @relation("SchedulePair")
  modalities   ScheduleModality[]

  @@map("schedules")
}

// One slot = one student occupying one schedule
model ScheduleSlot {
  id         String   @id @default(cuid())
  scheduleId String
  studentId  String
  teacherId  String?
  assignedAt DateTime @default(now())
  releasedAt DateTime?
  isActive   Boolean  @default(true)

  schedule Schedule  @relation(fields: [scheduleId], references: [id])
  student  Student   @relation(fields: [studentId], references: [id])
  teacher  Teacher?  @relation(fields: [teacherId], references: [id])

  @@unique([scheduleId, studentId])
  @@map("schedule_slots")
}

model ScheduleModality {
  id         String         @id @default(cuid())
  scheduleId String
  modalityId String
  capacity   Int            @default(1)
  createdAt  DateTime       @default(now())

  schedule  Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  modality  ModalityConfig @relation(fields: [modalityId], references: [id])

  @@unique([scheduleId, modalityId])
  @@map("schedule_modalities")
}

// ─── Students ─────────────────────────────────

model Student {
  id                  String          @id @default(cuid())
  phone               String          @unique  // WhatsApp number — primary key for bot
  name                String
  status              StudentStatus   @default(PENDING_PAYMENT)
  modality            Modality
  teacherId           String?
  conversationState   ConversationState @default(NEW_CONTACT)
  conversationData    Json?           // Temporary onboarding data
  enrollmentPaidAt    DateTime?       // Annual enrollment
  enrollmentExpiresAt DateTime?       // 1 year from enrollmentPaidAt
  regulationAcceptedAt DateTime?
  regulationVersion   String?
  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tutorName    String?   // Name of parent/guardian for minors
  enrolledAt   DateTime? // Date of manual enrollment by admin
  paymentDay   Int?      // Day of month (1-28) when student pays
  teacher             Teacher?                 @relation(fields: [teacherId], references: [id])
  scheduleSlots       ScheduleSlot[]
  payments            Payment[]
  waitingList         WaitingList[]
  notifications       NotificationLog[]
  courseEnrollments   SummerCourseEnrollment[]

  @@map("students")
}

// ─── Payments ─────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  studentId     String
  type          PaymentType
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(10, 2)
  period        String?       // "2026-05" for monthly
  notes         String?
  confirmedAt   DateTime?
  confirmedById String?       // User (admin) who confirmed
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@map("payments")
}

// ─── Waiting List ──────────────────────────────

model WaitingList {
  id           String    @id @default(cuid())
  scheduleId   String
  studentId    String
  position     Int       // FIFO position
  notifiedAt   DateTime? // When slot became available and we notified
  respondBy    DateTime? // Deadline to confirm
  confirmedAt  DateTime?
  skippedAt    DateTime?
  createdAt    DateTime  @default(now())

  schedule Schedule @relation(fields: [scheduleId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@unique([scheduleId, studentId])
  @@map("waiting_list")
}

// ─── Regulation Signatures ────────────────────

model RegulationSignature {
  id                String   @id @default(cuid())
  studentPhone      String
  regulationVersion String
  acceptedAt        DateTime @default(now())
  ipAddress         String?
  userAgent         String?

  @@map("regulation_signatures")
}

// ─── Bot Conversation State ────────────────────

model BotSession {
  id        String   @id @default(cuid())
  phone     String   @unique
  state     ConversationState @default(NEW_CONTACT)
  data      Json?    // Ephemeral context during multi-step flow
  updatedAt DateTime @updatedAt

  @@map("bot_sessions")
}

// ─── Notification Log ─────────────────────────

model NotificationLog {
  id          String   @id @default(cuid())
  studentId   String?
  phone       String
  type        String   // "REMINDER_DAY1" | "SLOT_RELEASED" | "WELCOME" etc.
  message     String
  sentAt      DateTime @default(now())
  twilioSid   String?
  error       String?

  student Student? @relation(fields: [studentId], references: [id])

  @@map("notification_logs")
}

// ─── Automation Log (idempotency) ─────────────

model AutomationLog {
  id        String              @id @default(cuid())
  jobName   String
  runAt     DateTime            @default(now())
  status    AutomationLogStatus
  details   Json?
  error     String?

  @@map("automation_logs")
}

// ─── Audit Log ────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // "STUDENT_CREATED" | "PAYMENT_CONFIRMED" etc.
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// ─── WhatsApp Session (Baileys auth persistence) ──
model WhatsAppSession {
  id        String   @id @default("main")
  creds     Json     // Baileys auth credentials
  keys      Json     // Baileys signal keys
  updatedAt DateTime @updatedAt

  @@map("whatsapp_sessions")
}

// ─── Summer Courses ───────────────────────────

enum CourseStatus {
  DRAFT      // En preparación, no visible en bot
  ACTIVE     // Abierto a inscripciones
  INACTIVE   // Cerrado temporalmente
  FINISHED   // Curso terminado
}

enum EnrollmentStatus {
  PENDING    // Alumno interesado via bot — esperando confirmación admin
  CONFIRMED  // Admin confirmó y registró pago
  CANCELLED  // Cancelado por admin o alumno
}

model SummerCourse {
  id          String       @id @default(cuid())
  name        String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  maxCapacity Int
  startDate   DateTime
  endDate     DateTime
  period      String       // Ej: "1 clase diaria de 1 hora"
  schedule    String?      // Ej: "Lunes a viernes 9:00-10:00am"
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  enrollments SummerCourseEnrollment[]
  teachers    SummerCourseTeacher[]

  @@map("summer_courses")
}

model SummerCourseTeacher {
  id        String   @id @default(cuid())
  courseId  String
  teacherId String
  createdAt DateTime @default(now())

  course  SummerCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([courseId, teacherId])
  @@map("summer_course_teachers")
}

model SummerCourseEnrollment {
  id          String           @id @default(cuid())
  courseId    String
  studentId   String?          // Null if student not yet registered in main system
  studentPhone String          // Always stored for bot identification
  studentName String
  status      EnrollmentStatus @default(PENDING)
  paidAt      DateTime?
  confirmedById String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  course  SummerCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student?     @relation(fields: [studentId], references: [id])

  @@unique([courseId, studentPhone])
  @@map("summer_course_enrollments")
}
